// Prisma 스키마. 모델을 추가한 뒤 `npm run db:migrate`로 마이그레이션을 만든다.
// https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── 유저 ───────────────────────────────────────────

enum UserStatus {
  ACTIVE
  LOCKED
  BLOCKED
  WITHDRAWN

  @@map("user_status")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

/// 2차 보안 설정 상태
enum TwoFactorStatus {
  /// 설정한 적 없음
  NOT_SET
  ENABLED
  /// 설정했다가 해제함
  DISABLED

  @@map("two_factor_status")
}

model User {
  id                    Int             @id @default(autoincrement()) @map("user_id")
  loginId               String          @unique @map("login_id") @db.VarChar(20)
  /// argon2 해시
  password              String          @db.VarChar(255)
  email                 String?         @unique @db.VarChar(255)
  /// 연락처. SMS 인증 전에는 2차 보안 번호로 쓰지 않는다.
  phoneNumber           String?         @map("phone_number") @db.VarChar(11)
  nickname              String?         @unique @db.VarChar(10)
  birthDate             DateTime?       @map("birth_date") @db.Date
  termsAgreed           Boolean         @map("terms_agreed")
  privacyAgreed         Boolean         @map("privacy_agreed")
  marketingAgreed       Boolean         @map("marketing_agreed")
  nightPushEnabled      Boolean         @default(true) @map("night_push_enabled")
  isPushEnabled         Boolean         @default(true) @map("is_push_enabled")
  userStatus            UserStatus      @default(ACTIVE) @map("user_status")
  reason                String?         @db.VarChar(50)
  deletedDate           DateTime?       @map("deleted_date") @db.Timestamptz(3)
  isDeleted             Boolean         @default(false) @map("is_deleted")
  role                  Role            @default(USER)
  /// 연속 로그인 실패 횟수. 로그인 성공 시 0으로 초기화한다.
  loginFailCount        Int             @default(0) @map("login_fail_count")
  lastLoginDate         DateTime?       @map("last_login_date") @db.Timestamptz(3)
  twoFactorStatus       TwoFactorStatus @default(NOT_SET) @map("two_factor_status")
  /// 2차 보안 인증 휴대폰. SMS 인증을 마친 번호만 들어간다. 해제하면 null이다.
  twoFactorPhoneNumber  String?         @map("two_factor_phone_number") @db.VarChar(11)
  /// 2차 보안을 설정(또는 휴대폰을 변경)한 시각
  twoFactorEnabledDate  DateTime?       @map("two_factor_enabled_date") @db.Timestamptz(3)
  /// 마지막 2차 보안 SMS 인증 성공 시각. 중요 기능 재인증은 이 시각부터 10분 동안 유효하다.
  twoFactorVerifiedDate DateTime?       @map("two_factor_verified_date") @db.Timestamptz(3)
  /// 2차 보안 SMS 인증번호 연속 오입력 횟수. 인증 성공 시 0, 5회가 되면 30분 제한 후 0으로 초기화한다.
  twoFactorFailCount    Int             @default(0) @map("two_factor_fail_count")
  /// SMS 인증번호를 5회 잘못 입력해 2차 보안 인증이 제한되는 시각까지. 계정 잠금과는 별개다.
  twoFactorLockedUntil  DateTime?       @map("two_factor_locked_until") @db.Timestamptz(3)
  /// 첫 주문을 접수한 시각. 이 값이 없고 2차 보안을 설정했으면 첫 주문 전에 재인증한다.
  orderActivatedDate    DateTime?       @map("order_activated_date") @db.Timestamptz(3)
  createDate            DateTime        @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate          DateTime        @updatedAt @map("modified_date") @db.Timestamptz(3)

  account                 Account?
  trustedDevices          TrustedDevice[]
  twoFactorHistories      TwoFactorHistory[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  searchHistories         SearchHistory[]
  viewHistories           ViewHistory[]
  wishlists               Wishlist[]
  attachmentCollections   AttachmentCollection[]
  listingApplications     ListingApplication[]
  notifications           Notification[]
  revisionRequestsCreated ListingApplicationRevision[] @relation("RevisionRequestAuthor")
  priceAlerts             PriceAlert[]
  inquiries               Inquiry[]
  assignedInquiries       Inquiry[]                    @relation("InquiryAssignee")
  inquiryRepliesSent      InquiryReplyAttempt[]        @relation("InquiryReplyActor")
  inquiryAccessAttempt    InquiryAccessAttempt?
  adminActivityLogs       AdminActivityLog[]
  anomalies               Anomaly[]                    @relation("AnomalyUser")
  anomaliesHandled        Anomaly[]                    @relation("AnomalyHandler")
  adminProfile            AdminProfile?

  @@map("users")
}

// ─── 계정·인증 문의 (일반 마이페이지 문의와 별도) ───────────────

enum InquirySource {
  /// 기존 문의 전용 토큰으로 본인 확인한 제한 계정 문의
  RESTRICTED_ACCOUNT
  /// USR-AUTH-10 비로그인 접수. 회신 주소로 회원을 연결하지 않는다.
  PUBLIC_ACCOUNT_AUTH

  @@map("inquiry_source")
}

enum InquiryType {
  LOGIN_FAILED_LOCKED
  SUSPENDED
  PHONE_UNAVAILABLE

  @@map("inquiry_type")
}

enum InquiryStatus {
  SUBMITTED
  IN_PROGRESS
  /// 문의 답변 처리 완료. 회원 승인·계정 해제를 뜻하지 않는다.
  COMPLETED

  @@map("inquiry_status")
}

model Inquiry {
  id                   Int                   @id @default(autoincrement()) @map("inquiry_id")
  /// 비로그인 접수는 null. 이메일만으로 회원을 추정·연결하지 않는다.
  userId               Int?                  @map("user_id")
  source               InquirySource         @default(RESTRICTED_ACCOUNT)
  inquiryCode          String                @unique @map("inquiry_code") @db.VarChar(32)
  inquiryType          InquiryType           @map("inquiry_type")
  title                String                @db.VarChar(100)
  content              String                @db.VarChar(5000)
  status               InquiryStatus         @default(SUBMITTED) @map("inquiry_status")
  createDate           DateTime              @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate         DateTime              @updatedAt @map("modified_date") @db.Timestamptz(3)
  /// 접수 당시 회신 주소. 비로그인은 직접 입력한 주소, 기존 본인 확인 문의는 가입 이메일이다.
  replyEmail           String?               @map("reply_email") @db.VarChar(255)
  assignedAdminId      Int?                  @map("assigned_admin_id")
  processingStartedAt  DateTime?             @map("processing_started_at") @db.Timestamptz(3)
  replyDraft           String?               @map("reply_draft") @db.VarChar(5000)
  replyVersion         Int                   @default(0) @map("reply_version")
  /// 실제 메일 발송 요청 접수 시각. 콘솔 모의 발송에서는 null이다.
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz(3)
  activeReplyAttemptId String?               @unique @map("active_reply_attempt_id") @db.Uuid
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedAdmin        User?                 @relation("InquiryAssignee", fields: [assignedAdminId], references: [id], onDelete: Restrict)
  replyAttempts        InquiryReplyAttempt[] @relation("InquiryReplyAttempts")
  activeReplyAttempt   InquiryReplyAttempt?  @relation("CurrentInquiryReply", fields: [activeReplyAttemptId], references: [id], onDelete: Restrict)

  @@index([userId, createDate, id])
  @@index([status, createDate, id])
  @@index([inquiryType, createDate, id])
  @@map("inquiries")
}

/// 공개 문의 접수 제한. 원문 IP·이메일 대신 목적별 HMAC 키만 저장한다.
model InquirySubmissionLimit {
  key       String   @id @db.VarChar(64)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("inquiry_submission_limits")
}

/// 외부 발송 결과는 완료 상태·활동 이력 반영 실패와 구분해 보존한다.
enum InquiryReplyStatus {
  SENDING
  ACCEPTED
  FAILED
  UNKNOWN
  SIMULATED

  @@map("inquiry_reply_status")
}

model InquiryReplyAttempt {
  id                String             @id @default(uuid()) @db.Uuid
  inquiryId         Int                @map("inquiry_id")
  requestId         String             @map("request_id") @db.Uuid
  adminId           Int                @map("admin_id")
  draftVersion      Int                @map("draft_version")
  toEmail           String             @map("to_email") @db.VarChar(255)
  replyText         String             @map("reply_text") @db.VarChar(5000)
  status            InquiryReplyStatus @default(SENDING)
  deliveryMode      String?            @map("delivery_mode") @db.VarChar(20)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(255)
  errorCode         String?            @map("error_code") @db.VarChar(80)
  /// 불명확한 이전 시도를 확인한 뒤 명시적으로 재발송한 경우의 사유.
  retryReason       String?            @map("retry_reason") @db.VarChar(200)
  createDate        DateTime           @default(now()) @map("create_date") @db.Timestamptz(3)
  finishedAt        DateTime?          @map("finished_at") @db.Timestamptz(3)
  finalizedAt       DateTime?          @map("finalized_at") @db.Timestamptz(3)
  inquiry           Inquiry            @relation("InquiryReplyAttempts", fields: [inquiryId], references: [id], onDelete: Restrict)
  admin             User               @relation("InquiryReplyActor", fields: [adminId], references: [id], onDelete: Restrict)
  activeForInquiry  Inquiry?           @relation("CurrentInquiryReply")

  @@unique([inquiryId, requestId])
  @@index([inquiryId, createDate, id])
  @@map("inquiry_reply_attempts")
}

/// 문의 본인 확인 전용 실패 기록. 일반 로그인 실패 횟수/잠금과 분리한다.
model InquiryAccessAttempt {
  userId       Int       @id @map("user_id")
  failCount    Int       @default(0) @map("fail_count")
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inquiry_access_attempts")
}

// ─── 계좌 ───────────────────────────────────────────

enum CashLedgerType {
  DEPOSIT
  BUY
  SELL
  /// 추가 포인트 지급
  GRANT
  /// 포인트 리셋
  RESET
  /// 관리자 포인트 조정
  ADJUST
  /// 회원 탈퇴로 포인트 소멸
  WITHDRAWAL

  @@map("cash_ledger_type")
}

model Account {
  id               Int       @id @default(autoincrement()) @map("account_id")
  userId           Int       @unique @map("user_id")
  /// 예수금 (P). 주문에 묶인 금액(lockedCash)을 포함한 전체 보유 포인트
  cash             BigInt
  /// 매수 주문에 묶인 금액
  lockedCash       BigInt    @default(0) @map("locked_cash")
  /// 갱신 손실 방지용 버전
  version          BigInt    @default(0)
  /// 마지막 추가 포인트 지급 시각. 24시간 제한 기준이다.
  lastPointGrantAt DateTime? @map("last_point_grant_at") @db.Timestamptz(3)
  /// 마지막 포인트 리셋 시각. 7일 제한 기준이다.
  lastPointResetAt DateTime? @map("last_point_reset_at") @db.Timestamptz(3)
  createDate       DateTime  @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate     DateTime  @updatedAt @map("modified_date") @db.Timestamptz(3)

  user              User                @relation(fields: [userId], references: [id])
  ledgers           CashLedger[]
  pointResetHistory PointResetHistory[]
  holdings          Holding[]
  orders            Order[]

  @@map("accounts")
}

model CashLedger {
  id           BigInt         @id @default(autoincrement()) @map("ledger_id")
  accountId    Int            @map("account_id")
  /// 체결로 생긴 기록(BUY, SELL)이면 해당 체결. 지급·리셋·조정 등은 null이다.
  tradeId      BigInt?        @map("trade_id")
  type         CashLedgerType
  /// 증감 금액 (+ 또는 -). 수수료까지 반영한 실제 증감액이다.
  amount       BigInt
  /// amount 중 수수료
  fee          BigInt         @default(0)
  /// 실현손익. SELL일 때만 값이 있다. (매도대금 - 매도 수수료 - 매도분 매입금액)
  realizedPnl  BigInt?        @map("realized_pnl")
  /// 반영 직후 잔액
  balanceAfter BigInt         @map("balance_after")
  createDate   DateTime       @default(now()) @map("create_date") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])
  trade   Trade?  @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  @@index([accountId, createDate])
  @@index([tradeId])
  @@map("cash_ledgers")
}

// ─── 인증번호 ───────────────────────────────────────

enum VerificationChannel {
  EMAIL
  SMS

  @@map("verification_channel")
}

enum VerificationPurpose {
  SIGNUP
  FIND_LOGIN_ID
  /// 새 기기 로그인 확인 (미설정 계정은 이메일, 설정 계정은 SMS)
  NEW_DEVICE_LOGIN
  /// 2차 보안 휴대폰 등록·변경
  TWO_FACTOR_SETUP
  /// 중요 기능 실행 전 2차 보안 재인증
  TWO_FACTOR
  /// 마이페이지 연락처(휴대폰) 변경
  CONTACT_PHONE_CHANGE

  @@map("verification_purpose")
}

/// 이메일·SMS 인증번호. 원문은 저장하지 않고 해시만 저장한다.
model Verification {
  id           Int                 @id @default(autoincrement()) @map("verification_id")
  channel      VerificationChannel
  purpose      VerificationPurpose
  /// 이메일 주소 또는 휴대폰 번호
  target       String              @db.VarChar(255)
  codeHash     String              @map("code_hash") @db.VarChar(64)
  /// 재발송용으로 암호화한 인증번호 (AES-256-GCM)
  codeCipher   String?             @map("code_cipher") @db.VarChar(255)
  attemptCount Int                 @default(0) @map("attempt_count")
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz(3)
  /// 인증 성공 시각
  verifiedAt   DateTime?           @map("verified_at") @db.Timestamptz(3)
  /// 인증 결과를 사용한 시각 (회원가입 완료 등). 재발송으로 무효화된 경우에도 기록한다.
  consumedAt   DateTime?           @map("consumed_at") @db.Timestamptz(3)
  /// 마지막으로 발송에 성공한 시각. 재발송 제한은 이 시각 기준이다.
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  createDate   DateTime            @default(now()) @map("create_date") @db.Timestamptz(3)

  @@index([channel, purpose, target, createDate])
  @@map("verifications")
}

// ─── 인증 ───────────────────────────────────────────

/// 로그인 세션별 Refresh 토큰. 원문은 저장하지 않고 해시만 저장한다.
model RefreshToken {
  id         Int       @id @default(autoincrement()) @map("refresh_token_id")
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 재발급·로그아웃·비밀번호 변경 등으로 폐기된 시각
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createDate DateTime  @default(now()) @map("create_date") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// 비밀번호 재설정 링크용 일회용 토큰. 원문은 저장하지 않고 해시만 저장한다.
model PasswordResetToken {
  id         Int       @id @default(autoincrement()) @map("password_reset_token_id")
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// 비밀번호 변경에 사용했거나, 새 링크 발급으로 무효화된 시각
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createDate DateTime  @default(now()) @map("create_date") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createDate])
  @@map("password_reset_tokens")
}

/// 새 기기 확인을 통과한 기기. 마지막 사용 후 30일 동안 추가 확인 없이 로그인한다.
model TrustedDevice {
  id           Int      @id @default(autoincrement()) @map("trusted_device_id")
  userId       Int      @map("user_id")
  /// 프론트가 만든 기기 ID의 SHA-256 해시
  deviceIdHash String   @map("device_id_hash") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  lastUsedDate DateTime @map("last_used_date") @db.Timestamptz(3)
  createDate   DateTime @default(now()) @map("create_date") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceIdHash])
  @@map("trusted_devices")
}

enum TwoFactorAction {
  ENABLED
  PHONE_CHANGED
  DISABLED

  @@map("two_factor_action")
}

/// 2차 보안 설정·변경·해제 이력
model TwoFactorHistory {
  id          Int             @id @default(autoincrement()) @map("two_factor_history_id")
  userId      Int             @map("user_id")
  action      TwoFactorAction
  /// 설정·변경한 휴대폰 번호. 해제는 null이다.
  phoneNumber String?         @map("phone_number") @db.VarChar(11)
  ipAddress   String?         @map("ip_address") @db.VarChar(45)
  userAgent   String?         @map("user_agent") @db.VarChar(255)
  createDate  DateTime        @default(now()) @map("create_date") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createDate])
  @@map("two_factor_histories")
}

/// 포인트 리셋 조건
enum PointResetCondition {
  /// 보유 종목이 0개
  NO_HOLDINGS
  /// 주문에 예약된 포인트가 0P
  NO_LOCKED_CASH
  /// 보유 포인트가 초기 포인트의 10% 미만
  CASH_BELOW_LIMIT
  /// 마지막 리셋 후 7일 경과 (리셋한 적이 없으면 충족)
  RESET_INTERVAL_PASSED

  @@map("point_reset_condition")
}

enum PointResetResult {
  SUCCESS
  /// 리셋 조건 미충족
  NOT_ALLOWED
  /// 같은 계좌를 동시에 갱신해 반영하지 못함
  CONFLICT

  @@map("point_reset_result")
}

/// 포인트 리셋 시도 이력. 실패한 시도도 남긴다. 성공한 포인트 변경은 cash_ledgers에도 남는다.
model PointResetHistory {
  id               BigInt                @id @default(autoincrement()) @map("point_reset_history_id")
  accountId        Int                   @map("account_id")
  result           PointResetResult
  cashBefore       BigInt                @map("cash_before")
  /// 성공했을 때만 값이 있다.
  cashAfter        BigInt?               @map("cash_after")
  /// 충족하지 못한 조건 (NOT_ALLOWED일 때)
  failedConditions PointResetCondition[] @map("failed_conditions")
  createDate       DateTime              @default(now()) @map("create_date") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createDate])
  @@map("point_reset_histories")
}

// ─── 상품 ───────────────────────────────────────────

/// 상품 카테고리. 상장 신청에서 고르는 9개 값으로 고정한다.
model Sector {
  code         Int      @id @map("sector_code")
  name         String   @unique @map("sector_name") @db.VarChar(30)
  createDate   DateTime @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime @updatedAt @map("modified_date") @db.Timestamptz(3)

  stocks Stock[]

  @@map("sectors")
}

enum TradeStatus {
  /// 거래 대기 (상장 승인 후 거래 시작 전)
  PENDING
  /// 거래 가능
  ACTIVE
  /// 거래 중지
  PAUSED
  /// 거래 종료
  CLOSED

  @@map("trade_status")
}

/// 상장된 상품(종목). 상장 신청이 승인되면 만들어진다. 상세 화면에 보여줄 신청 정보도 함께 둔다.
model Stock {
  id                  Int         @id @default(autoincrement()) @map("stock_id")
  stockCode           String      @unique @map("stock_code") @db.VarChar(20)
  sectorCode          Int         @map("sector_code")
  name                String      @map("stock_name") @db.VarChar(30)
  /// 한 줄 소개
  summary             String      @db.VarChar(60)
  /// 상세 설명
  description         String?     @db.VarChar(500)
  logoImageUrl        String?     @map("logo_image_url") @db.VarChar(500)
  mainImageUrl        String      @map("main_image_url") @db.VarChar(500)
  officialUrl         String?     @map("official_url") @db.VarChar(2048)
  operatorName        String      @map("operator_name") @db.VarChar(50)
  /// 상장 주식 수 (상장 신청의 총 발행 수량)
  listedShares        BigInt      @map("listed_shares")
  /// 기준가 (최종 상장가). 체결이 없으면 현재가로 쓴다.
  basePrice           BigInt      @map("base_price")
  /// 호가 단위. 주문 가격은 이 값의 배수여야 한다.
  priceTickSize       BigInt      @map("price_tick_size")
  /// 최소 주문 가격
  minOrderPrice       BigInt      @map("min_order_price")
  /// 최소 주문 수량
  minOrderQty         BigInt      @map("min_order_qty")
  /// 확정 상장일(KST 달력 날짜). 기존 상품은 null.
  approvedListingDate DateTime?   @map("approved_listing_date") @db.Date
  /// 거래 시작일시. 기존 상품 API와 주문 처리의 의미를 유지한다.
  listingDate         DateTime    @map("listing_date") @db.Timestamptz(3)
  tradeStatus         TradeStatus @map("trade_status")
  /// 사용자 화면 공개 여부 (노출 상태). 비공개 상품은 사용자 상품 목록·검색·신규 상장·최근 본 종목·관심상품에 나오지 않는다.
  isPublic            Boolean     @default(true) @map("is_public")
  /// 거래 중지·종료 시 사용자 상품 상세에 보여줄 안내문. 거래를 재개하면 지운다.
  statusNotice        String?     @map("status_notice") @db.VarChar(200)
  /// 주요 서비스 지표 (상장 신청에서 입력한 값, 없으면 null)
  /// 월간 활성 사용자 수
  mau                 BigInt?
  /// 일간 활성 사용자 수
  dau                 BigInt?
  /// 연간 매출 (원, 최근 완료 회계연도)
  revenue             BigInt?
  /// 거래액 (원, 최근 12개월 결제 완료액 - 취소·환불)
  transactionVolume   BigInt?     @map("transaction_volume")
  /// 지표 집계 시작일
  metricsStartDate    DateTime?   @map("metrics_start_date") @db.Date
  /// 지표 집계 종료일
  metricsEndDate      DateTime?   @map("metrics_end_date") @db.Date
  isDeleted           Boolean     @default(false) @map("is_deleted")
  deletedDate         DateTime?   @map("deleted_date") @db.Timestamptz(3)
  createDate          DateTime    @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate        DateTime    @updatedAt @map("modified_date") @db.Timestamptz(3)

  sector             Sector              @relation(fields: [sectorCode], references: [code])
  viewHistories      ViewHistory[]
  wishlists          Wishlist[]
  holdings           Holding[]
  orders             Order[]
  trades             Trade[]
  charts             Chart[]
  priceAlerts        PriceAlert[]
  notices            Notice[]
  listingApplication ListingApplication?
  anomalies          Anomaly[]

  /// 발행 보류 시 PENDING을 유지하고 예약 재시도에서 제외한다. 관리자 확인용이다.
  listingBlockedAt     DateTime? @map("listing_blocked_at") @db.Timestamptz(3)
  listingBlockedReason String?   @map("listing_blocked_reason") @db.VarChar(255)

  @@index([sectorCode])
  @@index([listingDate])
  @@map("stocks")
}

/// 최근 검색어. 회원마다 최근 5개만 남긴다. 같은 검색어를 다시 검색하면 modifiedDate만 갱신한다.
model SearchHistory {
  id           Int      @id @default(autoincrement()) @map("search_id")
  userId       Int      @map("user_id")
  keyword      String   @db.VarChar(50)
  createDate   DateTime @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime @updatedAt @map("modified_date") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([userId, modifiedDate])
  @@map("search_histories")
}

/// 최근 본 종목. 회원마다 최근 3개만 남긴다. 같은 상품을 다시 보면 modifiedDate만 갱신한다.
model ViewHistory {
  userId       Int      @map("user_id")
  stockId      Int      @map("stock_id")
  createDate   DateTime @default(now()) @map("create_date") @db.Timestamptz(3)
  /// 마지막으로 본 시각
  modifiedDate DateTime @updatedAt @map("modified_date") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id])

  @@id([userId, stockId])
  @@index([userId, modifiedDate])
  @@map("view_histories")
}

/// 관심상품. createDate가 관심상품으로 등록한 시각이다.
model Wishlist {
  userId       Int      @map("user_id")
  stockId      Int      @map("stock_id")
  createDate   DateTime @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime @updatedAt @map("modified_date") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id])

  @@id([userId, stockId])
  @@index([userId, createDate])
  @@map("wishlists")
}

// ─── 거래 ───────────────────────────────────────────

/// 보유 상품. 보유 수량이 0이 되면 행을 지운다.
model Holding {
  id           Int      @id @default(autoincrement()) @map("holding_id")
  accountId    Int      @map("account_id")
  stockId      Int      @map("stock_id")
  /// 보유 수량. 매도 주문에 묶인 수량(lockedQty)을 포함한다.
  qty          BigInt
  /// 매도 주문에 묶인 수량. 매도 가능 수량은 qty - lockedQty다.
  lockedQty    BigInt   @default(0) @map("locked_qty")
  /// 총 매입 금액 (매수 수수료 포함). 평균 매입 단가는 totalAmount / qty로 계산한다.
  totalAmount  BigInt   @map("total_amount")
  createDate   DateTime @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime @updatedAt @map("modified_date") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id])
  stock   Stock   @relation(fields: [stockId], references: [id])

  @@unique([accountId, stockId])
  @@index([stockId])
  @@map("holdings")
}

enum OrderSide {
  BUY
  SELL

  @@map("order_side")
}

/// 주문 종류. 지금은 지정가만 지원한다.
enum OrderType {
  LIMIT

  @@map("order_type")
}

enum OrderStatus {
  /// 접수 (체결 전)
  ACCEPTED
  /// 일부 체결
  PARTIAL
  /// 전부 체결
  FILLED
  /// 취소 (일부 체결 후 남은 수량을 취소한 경우도 포함)
  CANCELED

  @@map("order_status")
}

/// 주문. 정정은 없고 취소 후 다시 주문한다.
model Order {
  id            BigInt      @id @default(autoincrement()) @map("order_id")
  accountId     Int         @map("account_id")
  stockId       Int         @map("stock_id")
  /// 중복 요청 방지용 키. 프론트가 주문마다 만든 UUID이고, 재전송할 때는 같은 값을 보낸다.
  clientOrderId String      @map("client_order_id") @db.Uuid
  side          OrderSide
  orderType     OrderType   @default(LIMIT) @map("order_type")
  /// 주문 가격 (지정가)
  price         BigInt
  /// 주문 수량
  qty           BigInt
  /// 누적 체결 수량
  filledQty     BigInt      @default(0) @map("filled_qty")
  /// 매수 주문에 아직 묶여 있는 포인트 (수수료 포함). 체결될 때마다 줄고, 취소하면 남은 금액을 푼다. 매도 주문은 0이다.
  lockedAmount  BigInt      @default(0) @map("locked_amount")
  status        OrderStatus @default(ACCEPTED)
  canceledDate  DateTime?   @map("canceled_date") @db.Timestamptz(3)
  createDate    DateTime    @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate  DateTime    @updatedAt @map("modified_date") @db.Timestamptz(3)

  account    Account   @relation(fields: [accountId], references: [id])
  stock      Stock     @relation(fields: [stockId], references: [id])
  buyTrades  Trade[]   @relation("BuyOrderTrades")
  sellTrades Trade[]   @relation("SellOrderTrades")
  anomalies  Anomaly[]

  @@unique([accountId, clientOrderId])
  // 서버 재시작 시 미체결 주문으로 호가창을 복구할 때 쓴다.
  @@index([stockId, status, side, price, createDate])
  @@index([accountId, createDate])
  @@map("orders")
}

/// 체결. 매수·매도 주문 한 쌍이 한 가격에 체결된 기록이다.
/// 나중에 들어온 주문이 체결을 일으킨 쪽이다. buyOrderId > sellOrderId면 매수 체결, 아니면 매도 체결이다.
model Trade {
  id          BigInt   @id @default(autoincrement()) @map("trade_id")
  stockId     Int      @map("stock_id")
  buyOrderId  BigInt   @map("buy_order_id")
  sellOrderId BigInt   @map("sell_order_id")
  /// 체결가 (먼저 호가창에 있던 주문의 가격)
  price       BigInt
  /// 체결 수량
  qty         BigInt
  createDate  DateTime @default(now()) @map("create_date") @db.Timestamptz(3)

  stock     Stock        @relation(fields: [stockId], references: [id])
  buyOrder  Order        @relation("BuyOrderTrades", fields: [buyOrderId], references: [id])
  sellOrder Order        @relation("SellOrderTrades", fields: [sellOrderId], references: [id])
  ledgers   CashLedger[]
  anomalies Anomaly[]

  // 최근 체결, 당일 거래 요약
  @@index([stockId, createDate])
  @@index([buyOrderId])
  @@index([sellOrderId])
  @@map("trades")
}

/// 봉 단위
enum ChartInterval {
  MINUTE
  HOUR
  DAY
  /// 월요일 시작
  WEEK
  MONTH

  @@map("chart_interval")
}

/// 차트 봉. 체결될 때마다 해당 시각이 속한 단위별 봉을 갱신한다.
/// 일·주·월 봉의 경계는 한국 시간 00시 기준이다. 체결이 없는 구간은 행이 없다.
model Chart {
  stockId     Int           @map("stock_id")
  interval    ChartInterval @map("candle_interval")
  /// 봉 시작 시각
  candleTime  DateTime      @map("candle_time") @db.Timestamptz(3)
  openPrice   BigInt        @map("open_price")
  highPrice   BigInt        @map("high_price")
  lowPrice    BigInt        @map("low_price")
  closePrice  BigInt        @map("close_price")
  /// 거래량 (체결 수량 합계)
  volume      BigInt
  /// 거래대금 (체결가 × 수량 합계)
  tradeAmount BigInt        @map("trade_amount")

  stock Stock @relation(fields: [stockId], references: [id])

  @@id([stockId, interval, candleTime])
  @@map("charts")
}

/// 지정가 알림. 체결가가 설정가에 처음 도달하면 한 번 알리고 꺼진다. 수정하면 다시 켜진다.
model PriceAlert {
  id            Int       @id @default(autoincrement()) @map("alert_id")
  userId        Int       @map("user_id")
  stockId       Int       @map("stock_id")
  /// 설정가
  targetPrice   BigInt    @map("target_price")
  /// 도달하면 false. 거래가 종료된 상품도 false다.
  isActive      Boolean   @default(true) @map("is_active")
  /// 수정할 때마다 올린다. 알림의 revision으로 써서 같은 설정은 한 번만 알린다.
  version       BigInt    @default(0)
  /// 알림이 울린 시각. 수정하면 비운다.
  triggeredDate DateTime? @map("triggered_date") @db.Timestamptz(3)
  createDate    DateTime  @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate  DateTime  @updatedAt @map("modified_date") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockId], references: [id])

  // 같은 상품에 같은 가격은 한 번만 등록한다.
  @@unique([userId, stockId, targetPrice])
  // 내 알림 목록
  @@index([userId, id])
  // 체결가 도달 감지
  @@index([stockId, isActive, targetPrice])
  @@map("price_alerts")
}

// 신청서 모듈에 연결하기 전에도 소유자와 첨부 개수 제한을 유지하는 작성 단위.
enum AttachmentPurpose {
  EVIDENCE
  LOGO
  MAIN_IMAGE

  @@map("attachment_purpose")
}

enum AttachmentKind {
  FILE
  LINK

  @@map("attachment_kind")
}

model AttachmentCollection {
  id          String                      @id @default(uuid()) @db.Uuid
  userId      Int                         @map("user_id")
  purpose     AttachmentPurpose
  description String?                     @db.VarChar(500)
  savedAt     DateTime?                   @map("saved_at") @db.Timestamptz(3)
  /// 보완 재제출에 사용한 묶음. 이후 파일·링크·설명·선택 목록 변경을 차단한다.
  frozenAt    DateTime?                   @map("frozen_at") @db.Timestamptz(3)
  createDate  DateTime                    @default(now()) @map("create_date") @db.Timestamptz(3)
  user        User                        @relation(fields: [userId], references: [id])
  attachments Attachment[]
  revision    ListingApplicationRevision?

  @@index([userId])
  @@map("attachment_collections")
}

// 이 테이블에는 저장소 업로드가 완료된 파일 또는 검증된 링크만 기록한다.
model Attachment {
  id           String               @id @default(uuid()) @db.Uuid
  collectionId String               @map("collection_id") @db.Uuid
  kind         AttachmentKind
  originalName String?              @map("original_name") @db.VarChar(255)
  contentType  String?              @map("content_type") @db.VarChar(100)
  size         Int?
  objectKey    String?              @unique @map("object_key") @db.VarChar(500)
  url          String?              @db.VarChar(2048)
  saved        Boolean              @default(false)
  createDate   DateTime             @default(now()) @map("create_date") @db.Timestamptz(3)
  collection   AttachmentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("attachments")
}

// ─── 공지·FAQ ───────────────────────────────────────

enum NoticeType {
  /// 전체 서비스 공지
  ALL
  /// 상품 공지
  STOCK

  @@map("notice_type")
}

/// 공지 저장 상태. POSTED의 게시 예약·게시 중·종료는 게시 기간으로 구분한다.
enum NoticeStatus {
  /// 임시 저장. 게시 필수 입력값이 미완성이어도 저장할 수 있다.
  DRAFT
  /// 게시. postStartDate부터 postEndDate 전까지 사용자에게 노출한다.
  POSTED
  /// 비공개. 사용자에게 숨기며 다시 게시할 수 있다.
  HIDDEN

  @@map("notice_status")
}

/// 공지사항. POSTED 상태이고 게시 기간 안에 있는 공지를 사용자에게 보여 준다.
/// 상품별 공지는 대상 상품도 공개 상태여야 한다. 사용자 게시일은 postStartDate다.
model Notice {
  id            Int          @id @default(autoincrement()) @map("notice_id")
  type          NoticeType   @map("notice_type")
  status        NoticeStatus @default(POSTED)
  /// 대상 상품 ID. 전체 서비스 공지와 대상 미선택 상품별 임시 저장은 null이다.
  stockId       Int?         @map("stock_id")
  title         String       @db.VarChar(100)
  content       String
  /// 중요 공지. 게시 중인 사용자 공지 목록에서 상단에 배치한다.
  isImportant   Boolean      @default(false) @map("is_important")
  /// 게시 시작 시각. 임시 저장에서만 null을 허용한다.
  postStartDate DateTime?    @map("post_start_date") @db.Timestamptz(3)
  /// 게시 종료 시각. null이면 계속 게시한다.
  postEndDate   DateTime?    @map("post_end_date") @db.Timestamptz(3)
  isDeleted     Boolean      @default(false) @map("is_deleted")
  deletedDate   DateTime?    @map("deleted_date") @db.Timestamptz(3)
  createDate    DateTime     @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate  DateTime     @updatedAt @map("modified_date") @db.Timestamptz(3)

  stock Stock? @relation(fields: [stockId], references: [id], onDelete: Restrict)

  @@index([postStartDate])
  @@index([stockId])
  @@map("notices")
}

enum FaqCategory {
  /// 거래/주문
  TRADE
  /// 포인트/자산
  POINT
  /// 계정/보안
  ACCOUNT
  /// 상장
  LISTING
  /// 기타
  ETC

  @@map("faq_category")
}

/// 자주 묻는 질문. sortOrder가 작은 것부터 보여 준다.
model Faq {
  id           Int         @id @default(autoincrement()) @map("faq_id")
  category     FaqCategory
  question     String      @db.VarChar(200)
  answer       String
  sortOrder    Int         @default(0) @map("sort_order")
  isDeleted    Boolean     @default(false) @map("is_deleted")
  deletedDate  DateTime?   @map("deleted_date") @db.Timestamptz(3)
  createDate   DateTime    @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime    @updatedAt @map("modified_date") @db.Timestamptz(3)

  @@index([category, sortOrder])
  @@map("faqs")
}

// 임시저장 데이터는 제출 시 검증·변환한다. 접수번호는 최종 제출 전까지 발급하지 않는다.
enum ListingApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  EXPIRED

  @@map("listing_application_status")
}

model ListingApplication {
  id                    Int                          @id @default(autoincrement()) @map("application_id")
  userId                Int                          @map("user_id")
  applicationNumber     String?                      @unique @map("application_number") @db.VarChar(30)
  /// 후속 최종 제출 API가 기록한다. 임시저장에서는 null을 유지한다.
  submittedAt           DateTime?                    @map("submitted_at") @db.Timestamptz(3)
  /// 관리자 심사 API가 기록하는 최근 의견과 보완 기한.
  reviewComment         String?                      @map("review_comment")
  /// 승인 당시 최종 입력값. 신청자의 희망 입력값은 draftData에 보존한다.
  approvalData          Json?                        @map("approval_data")
  stockId               Int?                         @unique @map("stock_id")
  stock                 Stock?                       @relation(fields: [stockId], references: [id], onDelete: Restrict)
  revisionDeadline      DateTime?                    @map("revision_deadline") @db.Timestamptz(3)
  status                ListingApplicationStatus     @default(DRAFT)
  serviceName           String?                      @map("service_name") @db.VarChar(30)
  officialUrl           String?                      @map("official_url") @db.VarChar(2048)
  /// 진행 중 URL의 부분 UNIQUE 인덱스는 마이그레이션 SQL에서 관리한다.
  normalizedOfficialUrl String?                      @map("normalized_official_url") @db.VarChar(2048)
  currentStep           Int                          @default(1) @map("current_step")
  /// 미완성 입력값. 최종 제출용 필수값 검증은 별도 단계에서 수행한다.
  draftData             Json                         @default("{}") @map("draft_data")
  lastSavedAt           DateTime                     @default(now()) @map("last_saved_at") @db.Timestamptz(3)
  expiresAt             DateTime                     @map("expires_at") @db.Timestamptz(3)
  deletedDate           DateTime?                    @map("deleted_date") @db.Timestamptz(3)
  createDate            DateTime                     @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate          DateTime                     @updatedAt @map("modified_date") @db.Timestamptz(3)
  user                  User                         @relation(fields: [userId], references: [id])
  revisions             ListingApplicationRevision[]

  @@index([userId, status, lastSavedAt])
  @@index([status, expiresAt])
  @@map("listing_applications")
}

// ─── 회원 알림 ───────────────────────────────────────

enum NotificationType {
  ORDER
  PRICE
  LISTING_DRAFT_EXPIRING

  @@map("notification_type")
}

/// 앱 내 알림 이력. eventKey는 생산자가 재시도해도 바뀌지 않는 이벤트 식별자다.
model Notification {
  id           Int              @id @default(autoincrement()) @map("notification_id")
  userId       Int              @map("user_id")
  type         NotificationType @map("notification_type")
  eventKey     String           @map("event_key") @db.VarChar(200)
  content      String           @db.VarChar(500)
  /// 이벤트 발생 당시의 값. 금액·수량·거래 식별자는 문자열로 보존한다.
  payload      Json
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at") @db.Timestamptz(3)
  createDate   DateTime         @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime         @updatedAt @map("modified_date") @db.Timestamptz(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, eventKey])
  @@index([userId, createDate, id])
  @@index([userId, isRead])
  @@map("notifications")
}

/// 보완 요청 한 회차. 재요청은 새 행으로 남기고 최초 신청번호와 접수일은 유지한다.
model ListingApplicationRevision {
  id                   Int                   @id @default(autoincrement()) @map("revision_id")
  applicationId        Int                   @map("application_id")
  requestedById        Int                   @map("requested_by_id")
  requestItems         String[]              @default([]) @map("request_items")
  requestContent       String                @map("request_content") @db.VarChar(2000)
  deadline             DateTime              @db.Timestamptz(3)
  /// 관리자 기한 연장 이력. 최초 지정 시점도 기록한다.
  deadlineHistory      Json                  @default("[]") @map("deadline_history")
  /// 보완 요청 당시 신청 데이터. 재제출로 기존 입력값을 잃지 않게 한다.
  previousData         Json                  @map("previous_data")
  resubmittedAt        DateTime?             @map("resubmitted_at") @db.Timestamptz(3)
  evidenceCollectionId String?               @unique @map("evidence_collection_id") @db.Uuid
  evidenceSnapshot     Json?                 @map("evidence_snapshot")
  createDate           DateTime              @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate         DateTime              @updatedAt @map("modified_date") @db.Timestamptz(3)
  application          ListingApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy          User                  @relation("RevisionRequestAuthor", fields: [requestedById], references: [id])
  evidenceCollection   AttachmentCollection? @relation(fields: [evidenceCollectionId], references: [id], onDelete: Restrict)

  // 미재제출 회차는 신청서당 하나만 허용하는 부분 UNIQUE 인덱스를 migration.sql에 추가한다.
  @@index([applicationId, id])
  @@map("listing_application_revisions")
}

/// 관리자 활동 이력의 작업 대상
enum AdminActivityTarget {
  /// 상장 신청
  LISTING_APPLICATION
  /// 상품
  STOCK
  /// 회원
  USER
  /// 관리자 계정
  ADMIN
  /// 공지
  NOTICE
  /// 계정·인증 문의
  INQUIRY
  /// 이상 거래
  ANOMALY

  @@map("admin_activity_target")
}

/// 관리자 활동 이력의 수행 작업. 작업 대상별로 쓸 수 있는 작업이 정해져 있다(admin-activity-logs.constants.ts).
enum AdminActivityAction {
  INQUIRY_START
  INQUIRY_REPLY_DRAFT_SAVE
  INQUIRY_REPLY_SEND
  LISTING_REVIEW_START
  LISTING_REVISION_DEADLINE_UPDATE
  LISTING_APPROVE
  LISTING_REVISION_REQUEST
  LISTING_REJECT
  STOCK_UPDATE
  STOCK_PAUSE
  STOCK_RESUME
  STOCK_CLOSE
  USER_STATUS_CHANGE
  USER_UNLOCK
  POINT_GRANT
  POINT_RECALL
  ADMIN_CREATE
  ADMIN_STATUS_CHANGE
  NOTICE_PUBLISH
  NOTICE_HIDE
  NOTICE_DELETE
  NOTICE_UPDATE
  ANOMALY_ACTION

  @@map("admin_activity_action")
}

enum AdminActivityResult {
  SUCCESS
  FAILURE

  @@map("admin_activity_result")
}

/// 관리자 활동 이력. 운영 기록이므로 수정·삭제하지 않는다.
model AdminActivityLog {
  id          BigInt              @id @default(autoincrement()) @map("activity_log_id")
  adminId     Int                 @map("admin_id")
  targetType  AdminActivityTarget @map("target_type")
  /// 대상의 PK (상장 신청 ID, 상품 ID, 회원·관리자 user_id, 공지 ID, 이상 거래 ID)
  targetId    BigInt              @map("target_id")
  /// 처리 당시 대상 이름 (상품명, 아이디, 공지 제목 등). 이름이 바뀌어도 당시 값을 남긴다.
  targetLabel String?             @map("target_label") @db.VarChar(100)
  action      AdminActivityAction
  result      AdminActivityResult @default(SUCCESS)
  /// 목록에 보여줄 변경 요약. 예) 거래 가능 → 거래 중지
  summary     String?             @db.VarChar(200)
  /// 변경 전 값 { 항목: 값 }
  beforeValue Json?               @map("before_value")
  /// 변경 후 값 { 항목: 값 }
  afterValue  Json?               @map("after_value")
  reason      String?             @db.VarChar(500)
  ipAddress   String?             @map("ip_address") @db.VarChar(45)
  userAgent   String?             @map("user_agent") @db.VarChar(255)
  createDate  DateTime            @default(now()) @map("create_date") @db.Timestamptz(3)

  admin User @relation(fields: [adminId], references: [id])

  @@index([createDate])
  @@index([adminId, createDate])
  @@index([targetType, targetId, createDate])
  @@map("admin_activity_logs")
}

/// 이상 거래 탐지 유형 (ADM-MON-01)
enum AnomalyType {
  /// 대량 주문
  LARGE_ORDER
  /// 반복 주문
  REPEATED_ORDER
  /// 비정상 가격 체결
  ABNORMAL_PRICE
  /// 주문 처리 실패
  ORDER_FAILURE
  /// 잔액 불일치
  BALANCE_MISMATCH

  @@map("anomaly_type")
}

/// 이상 거래 처리 상태
enum AnomalyStatus {
  /// 미처리
  PENDING
  /// 확인중. [조치 내용 확인]으로 상품 거래 중지·회원 정지 화면에 넘어간 상태
  REVIEWING
  /// 처리완료
  RESOLVED

  @@map("anomaly_status")
}

/// 이상 거래 조치 유형 (ADM-MON-02)
enum AnomalyAction {
  /// 상품 거래 중지
  STOCK_PAUSE
  /// 회원 정지
  USER_BLOCK
  /// 이상 없음
  NO_ISSUE

  @@map("anomaly_action")
}

/// 이상 거래. 주문·체결을 커밋한 뒤 탐지해 남긴다. 조치 전 확인 자료라 상품·회원 상태를 자동으로 바꾸지 않는다.
model Anomaly {
  id           Int            @id @default(autoincrement()) @map("anomaly_id")
  type         AnomalyType    @map("anomaly_type")
  status       AnomalyStatus  @default(PENDING)
  /// 관련 상품. 예약 포인트 불일치처럼 상품과 관계없으면 null
  stockId      Int?           @map("stock_id")
  /// 원인 회원
  userId       Int            @map("user_id")
  /// 관련 주문. 주문 처리 실패는 주문이 저장되지 않아 null
  orderId      BigInt?        @map("order_id")
  /// 관련 체결 (비정상 가격 체결)
  tradeId      BigInt?        @map("trade_id")
  /// 오류 코드. 예) PRICE_DEVIATION
  errorCode    String         @map("error_code") @db.VarChar(50)
  /// 목록의 오류 내용. 예) 가격 편차 초과
  errorMessage String         @map("error_message") @db.VarChar(200)
  /// 탐지 근거 { 항목: 값 }. 유형마다 항목이 다르다.
  evidence     Json
  detectedDate DateTime       @default(now()) @map("detected_date") @db.Timestamptz(3)
  /// 확인중이면 넘어간 조치, 처리완료면 확정한 조치
  action       AnomalyAction?
  /// 조치 사유. 처리완료 때 저장한다.
  actionReason String?        @map("action_reason") @db.VarChar(200)
  /// 처리한 관리자 user_id
  handledById  Int?           @map("handled_by")
  handledDate  DateTime?      @map("handled_date") @db.Timestamptz(3)
  createDate   DateTime       @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate DateTime       @updatedAt @map("modified_date") @db.Timestamptz(3)

  stock     Stock? @relation(fields: [stockId], references: [id])
  user      User   @relation("AnomalyUser", fields: [userId], references: [id])
  order     Order? @relation(fields: [orderId], references: [id])
  trade     Trade? @relation(fields: [tradeId], references: [id])
  handledBy User?  @relation("AnomalyHandler", fields: [handledById], references: [id])

  /// 같은 체결을 두 번 남기지 않는다. null은 겹쳐도 된다.
  @@unique([type, tradeId])
  @@index([detectedDate])
  @@index([status, detectedDate])
  // 반복 주문·잔액 불일치 중복 확인
  @@index([userId, type, detectedDate])
  @@map("anomalies")
}

// ─── 운영 통계 ───────────────────────────────────────

/// 하루(한국 시간) 운영 통계. 매일 00시가 지나면 배치가 전날 행을 만들고, 만든 행은 고치지 않는다.
/// 주별·월별은 일별 행을 묶어 계산한다.
model DailyStat {
  /// 집계 날짜 (한국 시간)
  statDate            DateTime @id @map("stat_date") @db.Date
  /// 전체 상품 거래량 합계 (일봉 합계)
  tradeVolume         BigInt   @map("trade_volume")
  /// 전체 상품 거래대금 합계 (일봉 합계)
  tradeAmount         BigInt   @map("trade_amount")
  /// 마감 시점 상장 상품 수 (거래 중·거래 중지). 이력이 남지 않는 값이라, 마감 뒤 첫 집계에서만 채우고 밀린 날은 null
  listedStockCount    Int?     @map("listed_stock_count")
  /// 마감 시점 상장 심사 대기 건수 (접수·검토 중)
  pendingListingCount Int?     @map("pending_listing_count")
  /// 마감 시점 계정 문의 대기 건수 (접수·처리 중)
  pendingInquiryCount Int?     @map("pending_inquiry_count")
  createDate          DateTime @default(now()) @map("create_date") @db.Timestamptz(3)

  @@map("daily_stats")
}

// ─── 관리자 계정 ─────────────────────────────────────

/// 관리자 계정 정보. 로그인 정보는 users(role=ADMIN)에 두고 관리자에게만 있는 값을 둔다.
/// 관리자 계정 생성 API로 만든 관리자만 행이 있다. seed 관리자처럼 행이 없으면 임시 비밀번호 상태가 아니다.
model AdminProfile {
  userId                 Int      @id @map("user_id")
  /// 관리자명. 동명이인을 허용한다.
  name                   String   @db.VarChar(20)
  /// 담당 업무 (참고값). 권한과 관계없다.
  duty                   String?  @db.VarChar(50)
  /// 임시 비밀번호 상태. 생성 시 true, 비밀번호를 바꾸면 false. true면 비밀번호 변경 외 관리자 API를 막는다.
  passwordChangeRequired Boolean  @default(true) @map("password_change_required")
  createDate             DateTime @default(now()) @map("create_date") @db.Timestamptz(3)
  modifiedDate           DateTime @updatedAt @map("modified_date") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("admin_profiles")
}
