# 실행 환경 (development | production | test)
NODE_ENV=development

# 서버 포트
PORT=3000

# 허용할 CORS origin (쉼표로 구분, 비우면 전체 허용)
CORS_ORIGINS=

# PostgreSQL 접속 URL (로컬은 docker-compose의 postgres)
DATABASE_URL=postgresql://motu:motu@localhost:5432/motu?schema=public

# 로그 레벨 (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
