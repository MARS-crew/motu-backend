# 실행 환경 (development | production | test)
NODE_ENV=development

# 서버 포트
PORT=3000

# 허용할 CORS origin (쉼표로 구분, 비우면 전체 허용)
CORS_ORIGINS=

# PostgreSQL 접속 URL (로컬은 docker-compose의 postgres)
DATABASE_URL=postgresql://motu:motu@localhost:5432/motu?schema=public

# 로그 레벨 (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Access 토큰 서명 키 (32자 이상). `openssl rand -base64 32`로 만든 값을 넣는다.
JWT_ACCESS_SECRET=

# Access 토큰 유효시간 (초, 기본 900 = 15분)
JWT_ACCESS_EXPIRES_IN=900

# Refresh 토큰 유효기간 (일, 기본 14)
JWT_REFRESH_EXPIRES_IN_DAYS=14

# 비밀번호 재설정 메일에 넣을 화면 주소 (뒤에 ?token=... 이 붙음)
PASSWORD_RESET_URL=http://localhost:5173/password-reset

# Brevo API 키 (Brevo > SMTP & API > API Keys). 비우면 메일을 보내지 않고 서버 로그에 출력한다.
BREVO_API_KEY=

# 발신자 이메일 (Brevo > Senders에서 인증한 주소). BREVO_API_KEY를 넣으면 필수.
MAIL_FROM_EMAIL=

# 받는 사람에게 보이는 발신자 이름
MAIL_FROM_NAME=MOTU

# SMS 발신자 이름 (영문·숫자 11자 이하, Brevo > SMS에서 등록한 Sender ID). BREVO_API_KEY와 함께 넣으면 SMS를 실제로 보낸다.
# 비우면 SMS를 보내지 않고 서버 로그에 출력한다 (SMS는 유료라 발송 여부를 정하기 전까지 운영도 로그로 확인).
SMS_SENDER=


# 파일 저장소: local(개발 전용) | s3(MinIO / Railway S3 호환 저장소)
FILE_STORAGE_DRIVER=local
FILE_LOCAL_DIRECTORY=.data/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
